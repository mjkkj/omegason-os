    "@shopify/shopify-app-session-storage-prisma": "^5.1.3",
    "isbot": "^4.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "@remix-run/node": "^2.11.1",
    "@remix-run/react": "^2.11.1",
    "@remix-run/serve": "^2.11.1"
  },
  "devDependencies": {
    "@remix-run/dev": "^2.11.1",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "eslint": "^8.57.0",
    "eslint-config-react-app": "^7.0.1",
    "prisma": "^5.20.0",
